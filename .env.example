# Bridge connection values (fill these in AIUI Studio AFTER importing — do NOT commit a real AK)
#
# The AIUI agent reads these from config.js on the glasses. On import,
# AIUI CODING/you paste the real value for `ak` into config.js in the editor.
# Keep this file as a placeholder; never commit a real AK to a public repo.
#
# Hermes (B) bridge:
#   url      = https://rokid-hermes.snowbig.com/api/sse
#   agentId  = hermes-agent
#   ak       = <the ROKID_AK value from ~/rokid-hermes-xdc/.env>
#   userId   = any stable id, e.g. "aiui-rokit"
#
# Claude Code bridge (alternative):
#   url      = https://rokid-claude.snowbig.com/rokid/sse
#   agentId  = claude-agent
#   ak       = <the ROKID_AGENT_AK value from ~/rokid-claude/.env>
#
# Request body (JSON) sent to the bridge:
#   { message_id, agent_id, user_id,
#     message: [{role:'user', type:'text', text}],
#     metadata: { context: { language: 'zh-CN' } } }
